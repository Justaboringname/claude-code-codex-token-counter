<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Liquid Glass app icon from icons/Assets.car (see scripts/build-app-icon.sh).
	     macOS 26+ uses it; older systems fall back to CFBundleIconFile (icon.icns). -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- The app keeps running with no visible window to upload sync snapshots
	     (every minute, plus a 5 s poll for phone refresh requests). App Nap
	     would stretch those timers once the window is hidden. -->
	<key>LSAppNapIsDisabled</key>
	<true/>
</dict>
</plist>
